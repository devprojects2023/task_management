<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Task Management App</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* Basic Styling for the table */
        body {
            font-family: sans-serif;
            margin: 20px;
            background-color: #f4f4f4;
        }
        h1 {
            color: #333;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            background-color: #fff;
            box-shadow: 0 2px 3px rgba(0,0,0,0.1);
        }
        th, td {
            padding: 12px 15px;
            border: 1px solid #ddd;
            text-align: left;
        }
        th {
            background-color: #007bff;
            color: white;
            font-weight: bold;
        }
        tr:nth-child(even) {
            background-color: #f2f2f2;
        }
        tr:hover {
            background-color: #e9e9e9;
        }
        .logout-btn {
            display: inline-block;
            padding: 10px 15px;
            margin-top: 20px;
            background-color: #dc3545;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            border: none;
            cursor: pointer;
        }
        .logout-btn:hover {
            background-color: #c82333;
        }
        .delete-btn {
            padding: 5px 10px;
            background-color: #dc3545;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .delete-btn:hover {
            background-color: #c82333;
        }
        #loadingMessage {
            text-align: center;
            padding: 20px;
            font-style: italic;
            color: #555;
        }
        #errorMessage {
            color: red;
            font-weight: bold;
            margin-top: 10px;
        }
        #successMessage {
            color: green;
            font-weight: bold;
            margin-top: 10px;
        }
        .action-td {
            text-align: center;
        }
        .refresh-btn {
            display: inline-block;
            padding: 8px 12px;
            margin-top: 10px;
            background-color: #28a745;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            border: none;
            cursor: pointer;
        }
        .refresh-btn:hover {
            background-color: #218838;
        }
    </style>
</head>
<body>
    <div class="admin-layout">
        <!-- Sidebar Navigation -->
        <div class="admin-sidebar">
            <div class="admin-logo">
                <i class="fas fa-tasks mr-2"></i>
                <span>TaskManager</span>
            </div>
            
            <ul class="admin-menu">
                <li class="admin-menu-item">
                    <a href="/admin/dashboard" class="admin-menu-link active">
                        <i class="fas fa-tachometer-alt mr-2"></i>
                        <span class="admin-menu-text">Dashboard</span>
                    </a>
                </li>
                <li class="admin-menu-item">
                    <a href="#" class="admin-menu-link">
                        <i class="fas fa-users mr-2"></i>
                        <span class="admin-menu-text">Users</span>
                    </a>
                </li>
                <li class="admin-menu-item">
                    <a href="#" class="admin-menu-link">
                        <i class="fas fa-tasks mr-2"></i>
                        <span class="admin-menu-text">Tasks</span>
                    </a>
                </li>
                <li class="admin-menu-item">
                    <a href="#" class="admin-menu-link">
                        <i class="fas fa-chart-bar mr-2"></i>
                        <span class="admin-menu-text">Analytics</span>
                    </a>
                </li>
                <li class="admin-menu-item">
                    <a href="#" class="admin-menu-link">
                        <i class="fas fa-cog mr-2"></i>
                        <span class="admin-menu-text">Settings</span>
                    </a>
                </li>
                <li class="admin-menu-item" style="margin-top: auto;">
                    <a href="javascript:void(0)" onclick="logout()" class="admin-menu-link">
                        <i class="fas fa-sign-out-alt mr-2"></i>
                        <span class="admin-menu-text">Logout</span>
                    </a>
                </li>
            </ul>
        </div>
        
        <!-- Main Content Area -->
        <div class="admin-content">
            <!-- Header -->
            <div class="admin-header">
                <h1 class="admin-title">Admin Dashboard</h1>
                
                <div class="admin-actions">
                    <div class="search-box">
                        <input type="text" id="searchInput" placeholder="Search users..." class="form-control">
                        <button class="btn btn-primary btn-sm" onclick="searchUsers()">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                    <div class="user-profile">
                        <span class="admin-badge">Admin</span>
                        <span class="admin-name">Administrator</span>
                    </div>
                </div>
            </div>
            
            <!-- Statistics Cards -->
            <div class="dashboard-stats">
                <div class="stats-card" id="totalUsersCard">
                    <div class="stats-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="stats-value">0</div>
                    <div class="stats-label">Total Users</div>
                </div>
                
                <div class="stats-card">
                    <div class="stats-icon" style="color: var(--accent);">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <div class="stats-value">0</div>
                    <div class="stats-label">New Users (Today)</div>
                </div>
                
                <div class="stats-card">
                    <div class="stats-icon" style="color: var(--success);">
                        <i class="fas fa-tasks"></i>
                    </div>
                    <div class="stats-value">0</div>
                    <div class="stats-label">Total Tasks</div>
                </div>
                
                <div class="stats-card">
                    <div class="stats-icon" style="color: var(--yellow);">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stats-value">0%</div>
                    <div class="stats-label">Completion Rate</div>
                </div>
            </div>
            
            <!-- System Messages -->
            <div id="successMessage" class="alert alert-success" style="display: none;"></div>
            <div id="errorMessage" class="alert alert-danger" style="display: none;"></div>
            <div id="loadingMessage" class="alert alert-info">Loading user data...</div>
            
            <!-- User Management Card -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">Registered Users</h3>
                    <div>
                        <button class="btn btn-sm btn-primary" onclick="fetchUsers()">
                            <i class="fas fa-sync-alt mr-1"></i> Refresh
                        </button>
                        <button class="btn btn-sm btn-success">
                            <i class="fas fa-download mr-1"></i> Export
                        </button>
                    </div>
                </div>
                
                <div class="table-responsive">
                    <table class="table" id="usersTable">
                        <thead>
                            <tr>
                                <th onclick="sortTable(0)">Username <i class="fas fa-sort"></i></th>
                                <th onclick="sortTable(1)">Email <i class="fas fa-sort"></i></th>
                                <th onclick="sortTable(2)">Phone <i class="fas fa-sort"></i></th>
                                <th onclick="sortTable(3)">Registered At <i class="fas fa-sort"></i></th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- User data will be loaded here by JavaScript -->
                        </tbody>
                    </table>
                </div>
                
                <div class="card-footer">
                    <div class="pagination-info">
                        Showing <span id="showingCount">0</span> of <span id="totalCount">0</span> users
                    </div>
                </div>
            </div>
            
            <!-- Public Tasks Management Card -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">Public Tasks Management</h3>
                    <div>
                        <button class="btn btn-sm btn-primary" onclick="fetchPublicTasks()">
                            <i class="fas fa-sync-alt mr-1"></i> Refresh
                        </button>
                        <button class="btn btn-sm btn-danger" id="deletePublicTasksBtn" onclick="deleteSelectedPublicTasks()" disabled>
                            <i class="fas fa-trash mr-1"></i> Delete Selected
                        </button>
                    </div>
                </div>
                
                <div class="table-responsive">
                    <table class="table" id="publicTasksTable">
                        <thead>
                            <tr>
                                <th>
                                    <input type="checkbox" id="selectAllPublicTasks" onclick="toggleSelectAllPublicTasks()">
                                </th>
                                <th>Task</th>
                                <th>Created At</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="publicTasksTableBody">
                            <!-- Public tasks will be loaded here by JavaScript -->
                            <tr>
                                <td colspan="4" class="text-center">Loading public tasks...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM Content Loaded');
            // Fetch users when the page loads
            fetchUsers();
            // Fetch public tasks when the page loads
            fetchPublicTasks();
            
            // Add search input event listener
            const searchInput = document.getElementById('searchInput');
            console.log('Search input element:', searchInput);
            
            if (searchInput) {
                searchInput.addEventListener('input', function(e) {
                    console.log('Input event fired:', e.target.value);
                    searchUsers();
                });
                searchInput.addEventListener('keyup', function(e) {
                    console.log('Keyup event fired:', e.key);
                    if (e.key === 'Enter') {
                        searchUsers();
                    }
                });
            }
        });

        // Show message function
        function showMessage(type, message) {
            const elem = document.getElementById(type + 'Message');
            elem.textContent = message;
            elem.style.display = 'block';
            
            // Auto-hide after 5 seconds
            setTimeout(() => {
                elem.style.display = 'none';
            }, 5000);
        }
        
        // Current sort state
        let currentSort = {
            column: -1,
            direction: 'asc'
        };
        
        // Sort table function
        function sortTable(columnIndex) {
            const table = document.getElementById('usersTable');
            const tbody = table.getElementsByTagName('tbody')[0];
            const rows = Array.from(tbody.getElementsByTagName('tr'));
            
            // Update sort direction
            if (currentSort.column === columnIndex) {
                currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
            } else {
                currentSort.column = columnIndex;
                currentSort.direction = 'asc';
            }
            
            // Sort rows
            rows.sort((a, b) => {
                const aValue = a.cells[columnIndex].textContent.trim();
                const bValue = b.cells[columnIndex].textContent.trim();
                
                // Special handling for date column
                if (columnIndex === 3) {
                    const aDate = new Date(aValue);
                    const bDate = new Date(bValue);
                    return currentSort.direction === 'asc' ? aDate - bDate : bDate - aDate;
                }
                
                // Regular string comparison
                return currentSort.direction === 'asc' 
                    ? aValue.localeCompare(bValue)
                    : bValue.localeCompare(aValue);
            });
            
            // Reappend rows in new order
            rows.forEach(row => tbody.appendChild(row));
            
            // Update sort icons
            const headers = table.querySelectorAll('th');
            headers.forEach((header, i) => {
                const icon = header.querySelector('i');
                if (i === columnIndex) {
                    icon.className = currentSort.direction === 'asc' 
                        ? 'fas fa-sort-up' 
                        : 'fas fa-sort-down';
                } else {
                    icon.className = 'fas fa-sort';
                }
            });
        }
        
        // Search users function
        function searchUsers() {
            console.log('Search function called');
            const searchText = document.getElementById('searchInput').value.toLowerCase().trim();
            console.log('Search text:', searchText);
            
            const tableBody = document.querySelector('#usersTable tbody');
            const rows = tableBody.querySelectorAll('tr');
            console.log('Total rows:', rows.length);
            
            let visibleCount = 0;
            const totalCount = rows.length;
            
            rows.forEach((row, index) => {
                // Skip the "No registered users found" row
                if (row.cells.length < 5) {
                    console.log('Skipping row', index, 'due to insufficient cells');
                    return;
                }
                
                const username = row.cells[0].querySelector('span')?.textContent.toLowerCase() || '';
                const email = row.cells[1].textContent.toLowerCase();
                const phone = row.cells[2].textContent.toLowerCase();
                
                console.log('Row', index, ':', { username, email, phone });
                
                if (username.includes(searchText) || email.includes(searchText) || phone.includes(searchText)) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });
            
            // Update pagination info
            document.getElementById('showingCount').textContent = visibleCount;
            console.log('Visible count:', visibleCount);
        }
        
        async function fetchUsers() {
            const token = localStorage.getItem('token') || sessionStorage.getItem('token');
            const loadingMessage = document.getElementById('loadingMessage');
            const tableBody = document.querySelector('#usersTable tbody');
            
            // Clear previous errors/messages
            document.getElementById('errorMessage').style.display = 'none';
            document.getElementById('successMessage').style.display = 'none';
            tableBody.innerHTML = '';
            loadingMessage.style.display = 'block';

            // For debugging - create temporary token if needed
            if (!token) {
                console.log('No token found in storage');
                localStorage.setItem('token', 'temporary-test-token');
                console.log('Created temporary test token for debugging');
            }

            try {
                const response = await fetch('/api/auth/admin/users', {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token || 'temporary-token'}`
                    }
                });

                loadingMessage.style.display = 'none';

                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.error || `HTTP error! Status: ${response.status}`);
                }

                const users = await response.json();

                // Update stats
                document.querySelector('#totalUsersCard .stats-value').textContent = users.length;
                document.getElementById('totalCount').textContent = users.length;
                document.getElementById('showingCount').textContent = users.length;
                
                if (users.length === 0) {
                    tableBody.innerHTML = '<tr><td colspan="5" class="text-center">No registered users found.</td></tr>';
                } else {
                    users.forEach(user => {
                        const row = tableBody.insertRow();
                        
                        // Create user avatar with initials
                        const usernameCell = row.insertCell(0);
                        const username = user.username || 'N/A';
                        const initials = username.charAt(0).toUpperCase();
                        
                        usernameCell.innerHTML = `
                            <div class="d-flex align-items-center">
                                <div class="user-avatar">${initials}</div>
                                <span>${username}</span>
                            </div>
                        `;
                        
                        row.insertCell(1).textContent = user.email;
                        row.insertCell(2).textContent = user.phone;
                        
                        // Format date
                        const createdDate = new Date(user.createdAt);
                        const formattedDate = createdDate.toLocaleDateString() + ' ' + 
                                             createdDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                        row.insertCell(3).textContent = formattedDate;
                        
                        // Add actions
                        const actionsCell = row.insertCell(4);
                        actionsCell.innerHTML = `
                            <div class="btn-group">
                                <button class="btn btn-sm btn-secondary view-btn" title="View Details">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-danger delete-btn" title="Delete User">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        `;
                        
                        // Add delete event listener
                        const deleteBtn = actionsCell.querySelector('.delete-btn');
                        deleteBtn.onclick = () => deleteUser(user._id, user.email);
                    });
                }

            } catch (error) {
                console.error('Error fetching users:', error);
                loadingMessage.style.display = 'none';
                showMessage('error', `Failed to load users: ${error.message}. You might need to log in again.`);
            }
        }

        async function deleteUser(userId, userEmail) {
            if (!confirm(`Are you sure you want to delete user ${userEmail}?`)) {
                return;
            }
            
            const token = localStorage.getItem('token') || sessionStorage.getItem('token');
            
            try {
                const response = await fetch(`/api/auth/admin/users/${userId}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token || 'temporary-token'}`
                    }
                });
                
                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.error || `HTTP error! Status: ${response.status}`);
                }
                
                showMessage('success', `User ${userEmail} has been deleted successfully.`);
                
                // Refresh the user list
                setTimeout(() => {
                    fetchUsers();
                }, 1000);
                
            } catch (error) {
                console.error('Error deleting user:', error);
                showMessage('error', `Failed to delete user: ${error.message}`);
            }
        }

        function logout() {
            localStorage.removeItem('token');
            sessionStorage.removeItem('token');
            window.location.href = '/login';
        }

        // Functions for Public Tasks Management
        let publicTasks = [];

        // Fetch public tasks from the server
        async function fetchPublicTasks() {
            try {
                const response = await fetch('/api/admin/public-tasks', {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + localStorage.getItem('token')
                    }
                });

                if (!response.ok) {
                    throw new Error('Failed to fetch public tasks');
                }

                publicTasks = await response.json();
                displayPublicTasks(publicTasks);
            } catch (error) {
                console.error('Error fetching public tasks:', error);
                document.getElementById('publicTasksTableBody').innerHTML = 
                    `<tr><td colspan="4" class="text-center">Error loading public tasks. ${error.message}</td></tr>`;
            }
        }

        // Display public tasks in the table
        function displayPublicTasks(tasks) {
            const tableBody = document.getElementById('publicTasksTableBody');
            
            if (tasks.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="4" class="text-center">No public tasks found</td></tr>';
                return;
            }
            
            // Sort tasks by timestamp in descending order (newest first)
            tasks.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
            
            tableBody.innerHTML = tasks.map((task, index) => {
                const date = new Date(task.timestamp).toLocaleString();
                return `
                    <tr>
                        <td>
                            <input type="checkbox" class="public-task-checkbox" data-id="${task._id}" onchange="updateDeleteButtonState()">
                        </td>
                        <td>${task.title}</td>
                        <td>${date}</td>
                        <td class="action-td">
                            <button class="delete-btn" onclick="deletePublicTask('${task._id}')">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
            
            // Reset the select all checkbox
            document.getElementById('selectAllPublicTasks').checked = false;
            // Update the delete button state
            updateDeleteButtonState();
        }

        // Toggle select all public tasks
        function toggleSelectAllPublicTasks() {
            const selectAll = document.getElementById('selectAllPublicTasks').checked;
            const checkboxes = document.querySelectorAll('.public-task-checkbox');
            
            checkboxes.forEach(checkbox => {
                checkbox.checked = selectAll;
            });
            
            updateDeleteButtonState();
        }

        // Update delete button state based on selections
        function updateDeleteButtonState() {
            const checkboxes = document.querySelectorAll('.public-task-checkbox:checked');
            const deleteButton = document.getElementById('deletePublicTasksBtn');
            
            deleteButton.disabled = checkboxes.length === 0;
        }

        // Delete a single public task
        async function deletePublicTask(taskId) {
            if (!confirm('Are you sure you want to delete this public task?')) {
                return;
            }
            
            try {
                console.log('Deleting public task:', taskId);
                const token = localStorage.getItem('token') || sessionStorage.getItem('token');
                
                const response = await fetch('/api/admin/public-tasks', {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token || 'temporary-token'}`
                    },
                    body: JSON.stringify({ ids: [taskId] })
                });
                
                console.log('Delete response status:', response.status);
                
                if (!response.ok) {
                    throw new Error('Failed to delete public task');
                }
                
                const result = await response.json();
                console.log('Delete response:', result);
                showMessage('success', result.message || 'Public task deleted successfully');
                fetchPublicTasks(); // Refresh the tasks list
            } catch (error) {
                console.error('Error deleting public task:', error);
                showMessage('error', 'Error deleting public task: ' + error.message);
            }
        }

        // Delete selected public tasks
        async function deleteSelectedPublicTasks() {
            const selectedCheckboxes = document.querySelectorAll('.public-task-checkbox:checked');
            
            if (selectedCheckboxes.length === 0) {
                showMessage('error', 'No public tasks selected for deletion');
                return;
            }
            
            if (!confirm(`Are you sure you want to delete ${selectedCheckboxes.length} public tasks?`)) {
                return;
            }
            
            const selectedIds = Array.from(selectedCheckboxes).map(checkbox => checkbox.dataset.id);
            console.log('Deleting selected public tasks:', selectedIds);
            
            try {
                const token = localStorage.getItem('token') || sessionStorage.getItem('token');
                
                const response = await fetch('/api/admin/public-tasks', {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token || 'temporary-token'}`
                    },
                    body: JSON.stringify({ ids: selectedIds })
                });
                
                console.log('Bulk delete response status:', response.status);
                
                if (!response.ok) {
                    throw new Error('Failed to delete public tasks');
                }
                
                const result = await response.json();
                console.log('Bulk delete response:', result);
                showMessage('success', result.message || 'Public tasks deleted successfully');
                fetchPublicTasks(); // Refresh the tasks list
            } catch (error) {
                console.error('Error deleting public tasks:', error);
                showMessage('error', 'Error deleting public tasks: ' + error.message);
            }
        }
    </script>
</body>
</html> 